declare_args() {
  toolchain_path = "/opt/homebrew/opt/llvm"
}

toolchain("clang") {
  # Common description prefixes in non-verbose invocation.
  pretty_build_prefix = "🔨 "
  pretty_link_prefix = "⛓️ "
  target_triple = "aarch64-unknown-unknown"

  cc = "${toolchain_path}/bin/clang"
  ld = "${toolchain_path}/bin/llvm-ld"

  tool("cc") {
    depfile = "{{output}}.deps"
    command = "$cc -o {{output}} -MMD -MF $depfile-c -target ${target_triple} {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} {{source}}"
    outputs = [
      "{{target_out_dir}}/{{target_output_name}}/objects/{{source_name_part}}.o",
    ]
    depsformat = "gcc"
    description = "$pretty_build_prefix CC: {{source_name_part}}"
  }

  tool("link") {
    outfile = "{{target_out_dir}}/{{target_output_name}}/executables/{{target_output_name}}"
    command = "$ld /nologo /nodefaultlib /entry:efi_main /subsystem:efi_application /machine:ARM64 /out:{{target_output_name}} {{inputs}}"
    outputs = [
      outfile,
    ]
    description = "$pretty_link_prefix Link Executable: {{target_output_name}}"
  }
}
